#!/usr/bin/env python3
# e5-hipda: 4D4Y (Discuz! 7.2) reader for the E5 info screen.
# The site is behind Cloudflare; sub-pages like forumdisplay.php pass, so this
# helper does plain HTTP with a desktop Chrome UA and keeps the login cookies.
import json
import os
import re
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
import http.cookiejar

BASE = 'https://www.4d4y.com/forum/'
COOKIE_FILE = '/etc/e5-infoscreen/plugins/hipda/cookies.json'
UA = ('Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 '
      '(KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36')
TIMEOUT = 20
# 版块 ID 取自开源客户端 gigode/4d4y_cli 的 FORUMS 表；名字是本机从
# forumdisplay.php?fid=N 的 <title> 里抓下来核对过的（index.php 被 Cloudflare 拦）。
STATIC_BOARDS = [
    (2, 'Discovery'), (6, 'Buy & Sell 交易服务区'), (7, 'Geek Talks · 奇客怪谈'),
    (9, 'Smartphone'), (12, 'PalmOS，Treo'), (14, 'Windows Mobile，PocketPC，HPC'),
    (22, '麦客爱苹果'), (23, '随笔与个人文集'), (24, '意欲蔓延'), (25, '吃喝玩乐'),
    (36, 'E-INK'), (50, 'DC,NB,MP3,Gadgets...'), (56, 'iPhone, iPod Touch，iPad'),
    (57, '疑似机器人'), (59, 'E-INK - Geek Talks · 奇客怪谈'),
]

jar = http.cookiejar.LWPCookieJar(COOKIE_FILE)
try:
    jar.load(ignore_discard=True, ignore_expires=True)
except Exception:
    pass

opener = urllib.request.build_opener(urllib.request.HTTPCookieProcessor(jar))


def headers(extra=None):
    h = {'User-Agent': UA,
         'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8',
         'Accept-Language': 'zh-CN,zh;q=0.9,en;q=0.8',
         'Upgrade-Insecure-Requests': '1'}
    if extra:
        h.update(extra)
    return h


def fetch(url, data=None):
    if not url.startswith('http'):
        url = urllib.parse.urljoin(BASE, url)
    body = urllib.parse.urlencode(data).encode() if data else None
    req = urllib.request.Request(url, data=body, headers=headers(
        {'Content-Type': 'application/x-www-form-urlencoded'} if body else None))
    for attempt in (0, 1):
        try:
            with opener.open(req, timeout=TIMEOUT) as r:
                raw = r.read(3 * 1024 * 1024)
                return raw.decode('gb18030', 'replace'), r.geturl()
        except urllib.error.HTTPError as e:
            if e.code == 403 and attempt == 0:
                time.sleep(2)
                continue
            raise


def save():
    try:
        os.makedirs(os.path.dirname(COOKIE_FILE), exist_ok=True)
        jar.save(ignore_discard=True, ignore_expires=True)
        os.chmod(COOKIE_FILE, 0o600)
    except Exception:
        pass


def is_guest(html):
    return ('您还未登录' in html) or ('无权访问该版块' in html) or ('您无权进行当前操作' in html)


def whoami(html):
    m = re.search(r'href="space\.php\?uid=\d+"[^>]*>([^<]{1,20})</a>', html)
    return m.group(1).strip() if m else ''


def strip_html(s):
    s = re.sub(r'(?is)<(script|style)[^>]*>.*?</\1>', ' ', s)
    s = re.sub(r'(?i)<br\s*/?>', '\n', s)
    s = re.sub(r'(?i)</(p|div|tr|li|h\d)>', '\n', s)
    s = re.sub(r'(?s)<[^>]+>', '', s)
    s = (s.replace('&nbsp;', ' ').replace('&amp;', '&').replace('&lt;', '<')
          .replace('&gt;', '>').replace('&quot;', '"').replace('&#39;', "'"))
    s = re.sub(r'[ \t]+', ' ', s)
    s = re.sub(r'\n{3,}', '\n\n', s)
    return s.strip()

def abs_url(u):
    """论坛里的图片有的是相对路径，补成绝对地址，否则插件页会去 127.0.0.1 找。"""
    if not u:
        return u
    if u.startswith('//'):
        return 'https:' + u
    if u.startswith('http://') or u.startswith('https://'):
        return u
    if u.startswith('/'):
        return 'https://www.4d4y.com' + u
    return 'https://www.4d4y.com/forum/' + u


def cmd_login(argv):
    # 凭据从 stdin 的 JSON 读，避免密码里的特殊字符被 shell 解释
    if not argv:
        try:
            argv = []
            d = json.load(sys.stdin)
            user, pwd = d.get('u', ''), d.get('p', '')
            qid, ans = str(d.get('q', '0')), d.get('a', '')
        except Exception as e:
            return {'ok': False, 'error': 'bad stdin: %s' % str(e)[:60]}
    else:
        user = argv[0] if len(argv) > 0 else ''
        pwd = argv[1] if len(argv) > 1 else ''
        qid = argv[2] if len(argv) > 2 else '0'
        ans = argv[3] if len(argv) > 3 else ''
    if not user or not pwd:
        return {'ok': False, 'error': '需要用户名和密码'}
    page, _ = fetch('logging.php?action=login')
    m = re.search(r'name="formhash" value="([^"]+)"', page)
    if not m:
        return {'ok': False, 'error': '登录页没有 formhash'}
    formhash = m.group(1)
    sid = re.search(r'name="sid" value="([^"]+)"', page)
    data = {
        'sid': sid.group(1) if sid else '',
        'formhash': formhash,
        'referer': '',
        'loginfield': 'username',
        'username': user,
        'password': pwd,
        'questionid': qid,
        'answer': ans,
        'cookietime': '2592000',
    }
    html, final = fetch('logging.php?action=login&loginsubmit=yes', data)
    save()
    if '密码错误' in html or '登录失败' in html:
        return {'ok': False, 'error': '用户名或密码不对'}
    if '请输入安全提问' in html or ('安全提问' in html and '答案错误' in html):
        return {'ok': False, 'error': '安全提问的答案不对'}
    probe_html, _ = fetch('forumdisplay.php?fid=2')
    if is_guest(probe_html):
        msg = strip_html(html)[:120]
        return {'ok': False, 'error': '登录未生效：' + msg}
    return {'ok': True, 'uname': whoami(probe_html)}


def cmd_state(argv):
    try:
        html, _ = fetch('forumdisplay.php?fid=2')
    except Exception as e:
        return {'ok': False, 'logged': False, 'error': str(e)[:80]}
    if is_guest(html):
        return {'ok': True, 'logged': False}
    return {'ok': True, 'logged': True, 'uname': whoami(html)}


def cmd_boards(argv):
    """版块列表用固定表：index.php 被 Cloudflare 挑战，抓不到导航。"""
    return {'ok': True, 'list': [{'fid': f, 'name': n} for f, n in STATIC_BOARDS]}


def cmd_threads(argv):
    fid = int(argv[0])
    page = int(argv[1]) if len(argv) > 1 else 1
    html, _ = fetch('forumdisplay.php?fid=%d&page=%d' % (fid, page))
    if '您还未登录' in html:
        return {'ok': False, 'error': '未登录', 'need_login': True}
    out, seen = [], set()
    # Discuz 7.2 的帖子行是 <tbody id="normalthread_NNN">，先按行解析，拿不到再退回整页扫链接
    for row in re.finditer(r'<tbody id="normalthread_(\d+)"(.*?)</tbody>', html, re.S):
        tid, body = row.group(1), row.group(2)
        # 行里第一个 viewthread 链接是文件夹图标，标题在后面那个带文字的链接上
        title = ''
        for lm in re.finditer(r'<a href="viewthread\.php\?tid=\d+[^"]*"[^>]*>(.*?)</a>', body, re.S):
            cand = strip_html(lm.group(1)).strip()
            if cand:
                title = cand
                break
        if not title or tid in seen:
            continue
        seen.add(tid)
        author = re.search(r'class="author".*?space\.php\?uid=\d+"[^>]*>([^<]{1,24})</a>', body, re.S)
        nums = re.search(r'class="nums"[^>]*>(.*?)</td>', body, re.S)
        rep = 0
        if nums:
            d = re.search(r'(\d+)', strip_html(nums.group(1)))
            rep = int(d.group(1)) if d else 0
        out.append({'tid': int(tid), 'title': title,
                    'author': strip_html(author.group(1)).strip() if author else '',
                    'replies': rep})
    if not out:
        for m in re.finditer(r'<a href="viewthread\.php\?tid=(\d+)[^"]*"[^>]*>(.*?)</a>', html, re.S):
            tid, title = m.group(1), strip_html(m.group(2)).strip()
            if not title or tid in seen or title.startswith('本版'):
                continue
            seen.add(tid)
            out.append({'tid': int(tid), 'title': title})
    pages = 1
    pm = re.findall(r'page=(\d+)', html)
    if pm:
        pages = max(int(x) for x in pm)
    return {'ok': True, 'list': out, 'page': page, 'pages': min(pages, 200)}


def cmd_thread(argv):
    tid = int(argv[0])
    page = int(argv[1]) if len(argv) > 1 else 1
    html, _ = fetch('viewthread.php?tid=%d&page=%d' % (tid, page))
    if is_guest(html):
        return {'ok': False, 'error': '未登录', 'need_login': True}
    title = ''
    m = re.search(r'<title>(.*?)</title>', html, re.S)
    if m:
        title = strip_html(m.group(1)).replace('- 4D4Y', '').strip()
    posts = []
    # 这套模板的正文是 <td class="t_msgfont" id="postmessage_NNN">，
    # 同页还有 <div class="postmessage firstpost"> 只是外层容器（没有 id）。
    marks = list(re.finditer(r'id="postmessage_(\d+)"[^>]*>', html))
    for idx, mk in enumerate(marks):
        pid = int(mk.group(1))
        start = mk.end()
        nxt = marks[idx + 1].start() if idx + 1 < len(marks) else len(html)
        # 正文单元格结束后紧跟 <div id="post_rate_div_N">，再往后是作者栏和操作栏
        # （发短消息/加好友/报告/引用/TOP）。不能按 </td> 截，引用块里也有，
        # 用 rfind 又会把下一楼的作者栏吞进来。
        pos = html.find('post_rate_div_', start)
        if pos < 0 or pos > nxt:
            pos = html.find('</td></tr></table>', start)
        if pos < 0 or pos > nxt:
            stop = nxt
        else:
            # 标记落在 <div id="post_rate_div_…"> 里面，退回到这个标签的开头，
            # 否则正文末尾会留下半截 '<div id="'
            stop = html.rfind('<', start, pos)
            if stop < 0:
                stop = pos
        raw = html[start:stop]
        body = strip_html(raw)[:3000]
        # 正文图片：缩略图是原图路径加 .thumb.jpg，原图在 onclick="zoom(this, '…')" 里
        imgs = []
        # parts 保留原文顺序：文字段和图片交替，前端照这个顺序渲染，
        # 否则图片会被统一堆到每楼末尾（用户看到的就是「全跑到最下面」）。
        parts = []
        pos = 0
        for im in re.finditer(r'<img[^>]*>', raw):
            tag = im.group(0)
            sm = re.search(r'src="([^"]+)"', tag)
            if not sm:
                continue
            thumb = sm.group(1)
            low = thumb.lower()
            if ('smilies' in low or 'avatar' in low or 'images/default' in low
                    or 'images/common' in low or 'logo.gif' in low):
                continue
            zm = re.search(r"zoom\(this,\s*'([^']+)'", tag)
            orig = zm.group(1) if zm else thumb
            thumb = abs_url(thumb)
            orig = abs_url(orig)
            seg = strip_html(raw[pos:im.start()])
            if seg.strip():
                parts.append({'k': 't', 'v': seg})
            imgs.append({'t': thumb, 'o': orig})
            parts.append({'k': 'i', 't': thumb, 'o': orig})
            pos = im.end()
        tail = strip_html(raw[pos:])
        if tail.strip():
            parts.append({'k': 't', 'v': tail})
        if not body and not imgs:
            continue
        # 第一帖前面还隔着标题栏，窗口放大一些，否则楼主的名字取不到
        prev = html[max(0, mk.start() - 12000):mk.start()]
        # 作者在正文前最近的一个 space.php 链接；优先认 postauthor 区块，避免拿到页头的当前用户
        author = ''
        pa = re.findall(r'class="postauthor".*?space\.php\?uid=\d+"[^>]*>([^<]{1,24})</a>', prev, re.S)
        if pa:
            author = pa[-1].strip()
        else:
            names = re.findall(r'space\.php\?uid=\d+"[^>]*>([^<]{1,24})</a>', prev)
            author = names[-1].strip() if names else ''
        tm = re.search(r'发表于 ([0-9]{4}-[0-9]{1,2}-[0-9]{1,2}[ 0-9:]*)', prev)
        posts.append({'pid': pid, 'author': author,
                      'time': tm.group(1).strip() if tm else '', 'text': body,
                      'imgs': imgs, 'parts': parts})
    pages = 1
    pm = re.findall(r'page=(\d+)', html)
    if pm:
        pages = max(int(x) for x in pm)
    try:
        with open('/tmp/e5-hipda-thread.log', 'a') as fh:
            fh.write('tid=%d page=%d posts=%d imgs=%d\n'
                     % (tid, page, len(posts), sum(len(x['imgs']) for x in posts)))
    except Exception:
        pass
    return {'ok': True, 'title': title, 'list': posts, 'page': page, 'pages': min(pages, 500)}


def post_form(url, data):
    """发帖用：Discuz 页面是 GBK，表单也必须按 gb18030 编码，否则中文会乱码。"""
    if not url.startswith('http'):
        url = urllib.parse.urljoin(BASE, url)
    body = urllib.parse.urlencode(data, encoding='gb18030').encode('gb18030')
    req = urllib.request.Request(url, data=body, headers=headers(
        {'Content-Type': 'application/x-www-form-urlencoded'}))
    with opener.open(req, timeout=TIMEOUT) as r:
        return r.read(3 * 1024 * 1024).decode('gb18030', 'replace'), r.geturl()


def cmd_reply(argv):
    # 回复内容从 stdin 的 JSON 读，避免换行和引号被 shell 拆开
    try:
        d = json.load(sys.stdin)
    except Exception as e:
        return {'ok': False, 'error': 'bad stdin: %s' % str(e)[:60]}
    tid = int(d.get('tid') or 0)
    msg = (d.get('message') or '').strip()
    dry = bool(d.get('dry'))
    if tid < 1:
        return {'ok': False, 'error': 'tid 不对'}
    if not msg:
        return {'ok': False, 'error': '内容为空'}
    if len(msg) > 20000:
        return {'ok': False, 'error': '内容太长'}

    page, _ = fetch('viewthread.php?tid=%d' % tid)
    if is_guest(page):
        return {'ok': False, 'error': '未登录', 'need_login': True}
    m = re.search(r'name="formhash" value="([^"]+)"', page)
    if not m:
        return {'ok': False, 'error': '页面里没有 formhash'}
    formhash = m.group(1)
    fm = re.search(r'name="fid" value="(\d+)"', page)
    if not fm:
        # 回复表单的 action 需要 fid；这个模板没放隐藏域，从面包屑里取
        fm = re.search(r'forumdisplay\.php\?fid=(\d+)', page)
    fid = fm.group(1) if fm else ''
    tm = re.search(r'<title>(.*?)</title>', page, re.S)
    subject = strip_html(tm.group(1)).replace('- 4D4Y', '').strip() if tm else ''

    if dry:
        return {'ok': True, 'dry': True, 'fid': fid, 'subject': subject,
                'formhash_len': len(formhash), 'message_len': len(msg)}

    data = {'formhash': formhash, 'subject': subject, 'message': msg, 'usesig': '1'}
    html, final = post_form(
        'post.php?action=reply&fid=%s&tid=%d&extra=&replysubmit=yes' % (fid, tid), data)

    low = html
    if '两次发表间隔' in low:
        return {'ok': False, 'error': '论坛限制：两次发表间隔太短'}
    for bad in ('对不起', '您无权', '需要审核', '禁止', '来路不正确'):
        if bad in low:
            return {'ok': False, 'error': '论坛拒绝：' + strip_html(html)[:120]}
    if '来路不正确' in low or 'formhash' in low and '您' in low and '回复' not in low:
        return {'ok': False, 'error': '论坛拒绝了这次提交（formhash/来源校验）'}
    if msg[:20] and msg[:20] in html:
        return {'ok': True, 'posted': True, 'url': final}
    if '您的回复' in low or '回复成功' in low:
        return {'ok': True, 'posted': True, 'url': final}
    snippet = strip_html(html)[:160]
    return {'ok': False, 'error': '没看到成功提示：' + snippet}


def cmd_debug(argv):
    """抓一个页面并返回去掉标签后的前 1200 字，用来核对解析是否符合实际结构。"""
    url = argv[0] if argv else ''
    if not url.startswith('http'):
        return {'ok': False, 'error': 'need url'}
    html, final = fetch(url)
    return {'ok': True, 'url': final, 'charset': 'gb18030', 'text': strip_html(html)[:1200]}


def main():
    if len(sys.argv) < 2:
        print(json.dumps({'ok': False, 'error': 'usage'}))
        return
    cmd, argv = sys.argv[1], sys.argv[2:]
    fn = {'login': cmd_login, 'state': cmd_state, 'boards': cmd_boards,
          'threads': cmd_threads, 'thread': cmd_thread, 'debug': cmd_debug,
          'reply': cmd_reply}.get(cmd)
    if not fn:
        print(json.dumps({'ok': False, 'error': 'unknown cmd'}))
        return
    try:
        print(json.dumps(fn(argv), ensure_ascii=False))
    except Exception as e:
        print(json.dumps({'ok': False, 'error': str(e)[:160]}, ensure_ascii=False))


if __name__ == '__main__':
    main()
