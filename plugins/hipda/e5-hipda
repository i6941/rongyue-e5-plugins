#!/usr/bin/env python3
# e5-hipda: 4D4Y (Discuz! 7.2) reader for the E5 info screen.
# The site is behind Cloudflare; sub-pages like forumdisplay.php pass, so this
# helper does plain HTTP with a desktop Chrome UA and keeps the login cookies.
import json
import os
import re
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
import http.cookiejar

BASE = 'https://www.4d4y.com/forum/'
COOKIE_FILE = '/etc/e5-infoscreen/plugins/hipda/cookies.json'
UA = ('Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 '
      '(KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36')
TIMEOUT = 20
# 版块 ID 取自开源客户端 gigode/4d4y_cli 的 FORUMS 表；名字是本机从
# forumdisplay.php?fid=N 的 <title> 里抓下来核对过的（index.php 被 Cloudflare 拦）。
STATIC_BOARDS = [
    (2, 'Discovery'), (6, 'Buy & Sell 交易服务区'), (7, 'Geek Talks · 奇客怪谈'),
    (9, 'Smartphone'), (12, 'PalmOS，Treo'), (14, 'Windows Mobile，PocketPC，HPC'),
    (22, '麦客爱苹果'), (23, '随笔与个人文集'), (24, '意欲蔓延'), (25, '吃喝玩乐'),
    (36, 'E-INK'), (50, 'DC,NB,MP3,Gadgets...'), (56, 'iPhone, iPod Touch，iPad'),
    (57, '疑似机器人'), (59, 'E-INK - Geek Talks · 奇客怪谈'),
]

jar = http.cookiejar.LWPCookieJar(COOKIE_FILE)
try:
    jar.load(ignore_discard=True, ignore_expires=True)
except Exception:
    pass

opener = urllib.request.build_opener(urllib.request.HTTPCookieProcessor(jar))


def headers(extra=None):
    h = {'User-Agent': UA,
         'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8',
         'Accept-Language': 'zh-CN,zh;q=0.9,en;q=0.8',
         'Upgrade-Insecure-Requests': '1'}
    if extra:
        h.update(extra)
    return h


def fetch(url, data=None):
    if not url.startswith('http'):
        url = urllib.parse.urljoin(BASE, url)
    body = urllib.parse.urlencode(data).encode() if data else None
    req = urllib.request.Request(url, data=body, headers=headers(
        {'Content-Type': 'application/x-www-form-urlencoded'} if body else None))
    for attempt in (0, 1):
        try:
            with opener.open(req, timeout=TIMEOUT) as r:
                raw = r.read(3 * 1024 * 1024)
                return raw.decode('gb18030', 'replace'), r.geturl()
        except urllib.error.HTTPError as e:
            if e.code == 403 and attempt == 0:
                time.sleep(2)
                continue
            raise


def save():
    try:
        os.makedirs(os.path.dirname(COOKIE_FILE), exist_ok=True)
        jar.save(ignore_discard=True, ignore_expires=True)
        os.chmod(COOKIE_FILE, 0o600)
    except Exception:
        pass


def is_guest(html):
    return ('您还未登录' in html) or ('无权访问该版块' in html) or ('您无权进行当前操作' in html)


def whoami(html):
    m = re.search(r'href="space\.php\?uid=\d+"[^>]*>([^<]{1,20})</a>', html)
    return m.group(1).strip() if m else ''


def strip_html(s):
    s = re.sub(r'(?is)<(script|style)[^>]*>.*?</\1>', ' ', s)
    s = re.sub(r'(?i)<br\s*/?>', '\n', s)
    s = re.sub(r'(?i)</(p|div|tr|li|h\d)>', '\n', s)
    s = re.sub(r'(?s)<[^>]+>', '', s)
    s = (s.replace('&nbsp;', ' ').replace('&amp;', '&').replace('&lt;', '<')
          .replace('&gt;', '>').replace('&quot;', '"').replace('&#39;', "'"))
    s = re.sub(r'[ \t]+', ' ', s)
    s = re.sub(r'\n{3,}', '\n\n', s)
    return s.strip()


def cmd_login(argv):
    # 凭据从 stdin 的 JSON 读，避免密码里的特殊字符被 shell 解释
    if not argv:
        try:
            argv = []
            d = json.load(sys.stdin)
            user, pwd = d.get('u', ''), d.get('p', '')
            qid, ans = str(d.get('q', '0')), d.get('a', '')
        except Exception as e:
            return {'ok': False, 'error': 'bad stdin: %s' % str(e)[:60]}
    else:
        user = argv[0] if len(argv) > 0 else ''
        pwd = argv[1] if len(argv) > 1 else ''
        qid = argv[2] if len(argv) > 2 else '0'
        ans = argv[3] if len(argv) > 3 else ''
    if not user or not pwd:
        return {'ok': False, 'error': '需要用户名和密码'}
    page, _ = fetch('logging.php?action=login')
    m = re.search(r'name="formhash" value="([^"]+)"', page)
    if not m:
        return {'ok': False, 'error': '登录页没有 formhash'}
    formhash = m.group(1)
    sid = re.search(r'name="sid" value="([^"]+)"', page)
    data = {
        'sid': sid.group(1) if sid else '',
        'formhash': formhash,
        'referer': '',
        'loginfield': 'username',
        'username': user,
        'password': pwd,
        'questionid': qid,
        'answer': ans,
        'cookietime': '2592000',
    }
    html, final = fetch('logging.php?action=login&loginsubmit=yes', data)
    save()
    if '密码错误' in html or '登录失败' in html:
        return {'ok': False, 'error': '用户名或密码不对'}
    if '请输入安全提问' in html or ('安全提问' in html and '答案错误' in html):
        return {'ok': False, 'error': '安全提问的答案不对'}
    probe_html, _ = fetch('forumdisplay.php?fid=2')
    if is_guest(probe_html):
        msg = strip_html(html)[:120]
        return {'ok': False, 'error': '登录未生效：' + msg}
    return {'ok': True, 'uname': whoami(probe_html)}


def cmd_state(argv):
    try:
        html, _ = fetch('forumdisplay.php?fid=2')
    except Exception as e:
        return {'ok': False, 'logged': False, 'error': str(e)[:80]}
    if is_guest(html):
        return {'ok': True, 'logged': False}
    return {'ok': True, 'logged': True, 'uname': whoami(html)}


def cmd_boards(argv):
    """版块列表用固定表：index.php 被 Cloudflare 挑战，抓不到导航。"""
    return {'ok': True, 'list': [{'fid': f, 'name': n} for f, n in STATIC_BOARDS]}


def cmd_threads(argv):
    fid = int(argv[0])
    page = int(argv[1]) if len(argv) > 1 else 1
    html, _ = fetch('forumdisplay.php?fid=%d&page=%d' % (fid, page))
    if '您还未登录' in html:
        return {'ok': False, 'error': '未登录', 'need_login': True}
    out, seen = [], set()
    # Discuz 7.2: each thread row has <a href="viewthread.php?tid=NNN...">title</a>
    for m in re.finditer(r'<a href="viewthread\.php\?tid=(\d+)[^"]*"[^>]*>(.*?)</a>', html, re.S):
        tid, title = m.group(1), strip_html(m.group(2)).strip()
        if not title or tid in seen or title.startswith('本版'):
            continue
        seen.add(tid)
        out.append({'tid': int(tid), 'title': title})
    pages = 1
    pm = re.findall(r'page=(\d+)', html)
    if pm:
        pages = max(int(x) for x in pm)
    return {'ok': True, 'list': out, 'page': page, 'pages': min(pages, 200)}


def cmd_thread(argv):
    tid = int(argv[0])
    page = int(argv[1]) if len(argv) > 1 else 1
    html, _ = fetch('viewthread.php?tid=%d&page=%d' % (tid, page))
    if '您还未登录' in html:
        return {'ok': False, 'error': '未登录', 'need_login': True}
    title = ''
    m = re.search(r'<title>(.*?)</title>', html, re.S)
    if m:
        title = strip_html(m.group(1)).replace('- 4D4Y', '').strip()
    posts = []
    # posts: <div class="postmessage" id="postmessage_NNN"> ... </div>
    for m in re.finditer(r'<div class="postmessage"[^>]*id="postmessage_(\d+)"[^>]*>(.*?)</div>', html, re.S):
        body = strip_html(m.group(2))
        if body:
            posts.append({'pid': int(m.group(1)), 'text': body[:4000]})
    if not posts:
        for m in re.finditer(r'id="postmessage_(\d+)"[^>]*>(.*?)</td>', html, re.S):
            body = strip_html(m.group(2))
            if body:
                posts.append({'pid': int(m.group(1)), 'text': body[:4000]})
    # authors, in document order
    names = [strip_html(x).strip() for x in
             re.findall(r'class="authi"[^>]*>.*?space\.php\?uid=\d+"[^>]*>([^<]+)</a>', html, re.S)]
    for i, p in enumerate(posts):
        p['author'] = names[i] if i < len(names) else ''
    pages = 1
    pm = re.findall(r'page=(\d+)', html)
    if pm:
        pages = max(int(x) for x in pm)
    return {'ok': True, 'title': title, 'list': posts, 'page': page, 'pages': min(pages, 500)}


def main():
    if len(sys.argv) < 2:
        print(json.dumps({'ok': False, 'error': 'usage'}))
        return
    cmd, argv = sys.argv[1], sys.argv[2:]
    fn = {'login': cmd_login, 'state': cmd_state, 'boards': cmd_boards,
          'threads': cmd_threads, 'thread': cmd_thread}.get(cmd)
    if not fn:
        print(json.dumps({'ok': False, 'error': 'unknown cmd'}))
        return
    try:
        print(json.dumps(fn(argv), ensure_ascii=False))
    except Exception as e:
        print(json.dumps({'ok': False, 'error': str(e)[:160]}, ensure_ascii=False))


if __name__ == '__main__':
    main()
